# Copy to .env. Every setting is optional. Never commit .env.

# --- Login option A: stored credentials (no browser, works on a server) -----
# Set these yourself (or inject them from a secret store). They are sent only
# to Shufersal's login form, never logged or written anywhere by the tool, and
# never shown to an AI assistant. Leave empty to log in through a browser
# window (option B) or by importing a session (option C) instead.
SHUFERSAL_USERNAME=
SHUFERSAL_PASSWORD=

# --- Requests ---------------------------------------------------------------
# http (default): plain HTTP with the saved session - no browser.
# browser: run every request inside Chrome instead (fallback if plain HTTP is
# ever refused; needs a desktop).
SHUFERSAL_TRANSPORT=http

# Saved session cookies. A logged-in key to the account until it expires -
# keep it private (gitignored).
SHUFERSAL_COOKIE_FILE=sessions/shufersal-cookies.json

# Remembered "this line means this product" choices (personal; gitignored).
SHUFERSAL_CHOICES_FILE=lists/choices.json

# Pause between product searches, in milliseconds. A person shopping, not a crawler.
SHUFERSAL_REQUEST_DELAY_MS=1200

# --- Browser login (option B) -------------------------------------------------
# Browser to drive: "chrome" or "msedge". Or set SHUFERSAL_BROWSER_EXECUTABLE.
SHUFERSAL_BROWSER_CHANNEL=chrome
SHUFERSAL_BROWSER_EXECUTABLE=

# The browser's own profile (keeps its login between runs; gitignored).
SHUFERSAL_USER_DATA_DIR=sessions/shufersal

# 1 (default): start hidden, show a window only when you need to log in. 0: always show it.
SHUFERSAL_HEADLESS=1

# How long to wait (seconds) for you to finish logging in.
SHUFERSAL_LOGIN_TIMEOUT_SECONDS=300
